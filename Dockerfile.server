FROM golang:1.22-alpine AS server-builder
WORKDIR /app
COPY server/ .
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -o /updara-server .

FROM golang:1.22-alpine AS agent-builder
WORKDIR /app
COPY agent/ .
RUN go mod tidy && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /binaries/updara-agent-amd64 . && \
    CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o /binaries/updara-agent-arm64 .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=server-builder /updara-server /updara-server
COPY --from=agent-builder /binaries /app/binaries
COPY connectors/ /app/connectors/
EXPOSE 8080
ENTRYPOINT ["/updara-server"]
